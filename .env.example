# Local SQLite file. Prisma resolves this relative to the prisma/ folder.
DATABASE_URL="file:./dev.db"

# Signs the session cookie. Production rejects this placeholder and any secret under 24 characters.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Public showcase only. Leave empty for a real client deploy.
# true allows the seeded login rosa@rivera.insurance / rivera-demo and the demo invite token.
DEMO_MODE=""

# Public URL of this app. Used for invite links and the Mac shortcut.
APP_URL="http://127.0.0.1:43123"

# LLM. auto uses Anthropic if ANTHROPIC_API_KEY is set, otherwise OpenAI, otherwise the built-in mock.
# mock | anthropic | openai | auto
LLM_PROVIDER="auto"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Channels. mock never dials or sends, even if keys are present.
# mock | live
CHANNEL_MODE="mock"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
AGENTPHONE_API_KEY=""
AGENTPHONE_BASE_URL=""
AGENTMAIL_API_KEY=""
AGENTMAIL_INBOX_ID=""

# Shared secret for POST /api/webhooks/inbound.
# Local default "demo" is rejected in production unless DEMO_MODE=true. Use a long random value for a real deploy.
DEMO_WEBHOOK_SECRET="demo"

# Computer. stub renders the local activity desktop. orgo keeps the same adapter seam for a later virtual desktop.
# stub | orgo
COMPUTER_PROVIDER="stub"
ORGO_API_KEY=""

# Connector stubs. Blank keys stay in sandbox.
HAWKSOFT_API_KEY=""
HAWKSOFT_AGENCY_ID=""
AMS360_APP_KEY=""
COMPOSIO_API_KEY=""
